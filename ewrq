import java.util.*;
class Solution {
    public double minimumTotalPrice(int[] prices, int[] discounts) {
        Arrays.sort(prices);
        Arrays.sort(discounts);
        double total = 0.0;
        int k = Math.min(prices.length, discounts.length);
        for (int i = 0; i < k; i++) {
            int price = prices[prices.length - 1 - i];
            int discount = discounts[discounts.length - 1 - i];
            total += (double) price * (100 - discount) / 100.0;
        }
        for (int i = 0; i < prices.length - k; i++) {
            total += prices[i];
        }
        return total;
    }
}
